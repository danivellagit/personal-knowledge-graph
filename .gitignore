# YOUR PRIVATE GRAPH LIVES IN data/ AND BY DEFAULT IS NEVER COMMITTED.
# This is the opposite default from a normal repo: data/ is your real life, keep it local.
# Everything directly under data/ is ignored except the two structure markers below.
#
# An owner who keeps their copy of this repo PRIVATE may choose to commit data/ as a backup:
# delete the data/ lines below (the three /data rules and the banks scaffolding block). The history then holds real people, health and money, so
# that repo must never be made public. Never do this in a public fork.
/data/*
!/data/.gitkeep
!/data/README.md
# the optional banks section ships scaffolding only (README + EXAMPLE files); your bank files stay ignored
!/data/finance/
/data/finance/*
!/data/finance/banks/
/data/finance/banks/*
!/data/finance/banks/README.md
!/data/finance/banks/statements/
/data/finance/banks/statements/*
!/data/finance/banks/statements/README.md
!/data/finance/banks/example-bank/
/data/finance/banks/example-bank/**
!/data/finance/banks/example-bank/README.md
!/data/finance/banks/example-bank/accounts.example.md
!/data/finance/banks/example-bank/transactions/
!/data/finance/banks/example-bank/transactions/example-bank-2030-01.example.md

# Local, instance-specific config (owner, sources, integration ids, module paths)
config.local.yml

# OS / editor / Python noise
.DS_Store
__pycache__/
