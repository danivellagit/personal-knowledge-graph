#!/usr/bin/env bash
# Versioned pre-commit hook (core.hooksPath = .githooks). Set it once per clone
# (worktrees share it):
#   git config core.hooksPath .githooks
# Checks and the emergency skip: see tools/precommit.py.
cd "$(git rev-parse --show-toplevel)" || exit 0
[ -f tools/precommit.py ] || exit 0          # older checkout without the guard: do not block
command -v python3 >/dev/null 2>&1 || { echo "pre-commit: python3 missing, checks skipped" >&2; exit 0; }
exec python3 tools/precommit.py
